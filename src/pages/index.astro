---
import Layout         from '../layouts/Layout.astro';
import Header         from '../components/Header.astro';
import Hero           from '../components/Hero.astro';
import HowItWorks     from '../components/HowItWorks.astro';
import ForPassengers  from '../components/ForPassengers.astro';
import ForDrivers     from '../components/ForDrivers.astro';
import Coverage       from '../components/Coverage.astro';
import Download       from '../components/Download.astro';
import Contact        from '../components/Contact.astro';
import Footer         from '../components/Footer.astro';
---

<Layout
  title="PochiGO Mototaxi — Tu mototaxi a un toque"
  description="Pide tu mototaxi en segundos con PochiGO. Rápido, seguro y económico. Disponible en Playa del Carmen, Cancún y más ciudades."
>
  <Header />
  <main>
    <Hero />
    <HowItWorks />
    <ForPassengers />
    <ForDrivers />
    <Coverage />
    <Download />
    <Contact />
  </main>
  <Footer />
</Layout>
