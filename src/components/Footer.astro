---
const currentYear = new Date().getFullYear();

const columns = [
  {
    title: 'Producto',
    links: [
      { label: 'Cómo funciona', href: '#como-funciona' },
      { label: 'Para pasajeros', href: '#pasajeros' },
      { label: 'Para conductores', href: '#conductores' },
      { label: 'Cobertura', href: '#cobertura' },
    ],
  },
  {
    title: 'Empresa',
    links: [
      { label: 'Sobre nosotros', href: '#' },
      { label: 'Blog', href: '#' },
      { label: 'Prensa', href: '#contacto' },
      { label: 'Trabaja con nosotros', href: '#' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Términos y condiciones', href: '#' },
      { label: 'Aviso de privacidad', href: '#' },
      { label: 'Política de cookies', href: '#' },
      { label: 'Reglas para conductores', href: '#' },
    ],
  },
];
---

<footer class="bg-ink-900 text-ink-300 pt-16 sm:pt-20 pb-8">
  <div class="container-x">
    <!-- Top: brand + columns -->
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 pb-12 border-b border-white/10">
      <!-- Brand block -->
      <div class="lg:col-span-4">
        <a href="#" class="inline-flex items-center gap-2.5">
          <img
            src={`${import.meta.env.BASE_URL}images/logo-icon.png`}
            alt="PochiGO"
            class="h-10 w-10 rounded-xl"
            width="40"
            height="40"
          />
          <span class="font-display font-extrabold text-2xl text-white">
            Pochi<span class="text-pochi-400">GO</span>
          </span>
        </a>
        <p class="mt-5 text-ink-400 leading-relaxed max-w-sm">
          La forma más rápida de moverte en mototaxi por tu ciudad.
          Hecho con cariño en México.
        </p>

        <!-- Social -->
        <div class="mt-7 flex gap-3">
          <a href="#" aria-label="Instagram" class="w-10 h-10 rounded-full bg-white/5 hover:bg-pochi-600 flex items-center justify-center transition-all">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zM12 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a href="#" aria-label="Facebook" class="w-10 h-10 rounded-full bg-white/5 hover:bg-pochi-600 flex items-center justify-center transition-all">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <a href="#" aria-label="TikTok" class="w-10 h-10 rounded-full bg-white/5 hover:bg-pochi-600 flex items-center justify-center transition-all">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64 2.93 2.93 0 01.88.13V9.4a6.84 6.84 0 00-1-.05A6.33 6.33 0 005.8 20.1a6.34 6.34 0 0010.86-4.43v-7a8.16 8.16 0 004.77 1.52v-3.4a4.85 4.85 0 01-1.84-.1z"/>
            </svg>
          </a>
          <a href="#" aria-label="Twitter" class="w-10 h-10 rounded-full bg-white/5 hover:bg-pochi-600 flex items-center justify-center transition-all">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Link columns -->
      {columns.map((col) => (
        <div class="lg:col-span-2">
          <h3 class="font-display font-bold text-white text-base mb-5">{col.title}</h3>
          <ul class="space-y-3">
            {col.links.map((l) => (
              <li>
                <a href={l.href} class="text-ink-400 hover:text-pochi-400 transition-colors text-sm">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <!-- Newsletter -->
      <div class="lg:col-span-2">
        <h3 class="font-display font-bold text-white text-base mb-5">Newsletter</h3>
        <p class="text-sm text-ink-400 mb-4 leading-relaxed">
          Recibe novedades y promos en tu correo.
        </p>
        <form class="space-y-2">
          <input
            type="email"
            placeholder="tu@correo.com"
            class="w-full px-3 py-2.5 rounded-lg bg-white/5 border border-white/10
                   text-white text-sm placeholder-ink-500
                   focus:outline-none focus:border-pochi-400 transition-colors"
            required
          />
          <button type="submit" class="w-full px-3 py-2.5 rounded-lg bg-pochi-600 hover:bg-pochi-500 text-white text-sm font-semibold transition-colors">
            Suscribirme
          </button>
        </form>
      </div>
    </div>

    <!-- Bottom -->
    <div class="pt-8 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-sm text-ink-500">
        © {currentYear} PochiGO. Todos los derechos reservados.
      </p>
      <p class="text-sm text-ink-500">
        Hecho con 💜 en México por <span class="font-semibold text-ink-300">Imaginaria Games</span>
      </p>
    </div>
  </div>
</footer>
