---
const channels = [
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`,
    title: 'Correo',
    value: 'imaginariagames@gmail.com',
    href:  'mailto:hola@pochigo.mx',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>`,
    title: 'WhatsApp',
    value: '+52 984 877 9596',
    href:  'https://wa.me/529848779596',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
    title: 'Oficina',
    value: 'Playa del Carmen, Q. Roo',
    href:  '#',
  },
];
---

<section id="contacto" class="section-y bg-ink-50">
  <div class="container-x">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-16">
      <!-- Left: copy + channels -->
      <div class="lg:col-span-5 reveal">
        <span class="eyebrow">Contacto</span>
        <h2 class="heading-lg mt-3">Hablemos</h2>
        <p class="lead mt-5">
          ¿Eres pasajero, conductor, prensa o socio comercial?
          Escríbenos y te respondemos en menos de 24 horas.
        </p>

        <div class="mt-10 space-y-4">
          {channels.map((c) => (
            <a
              href={c.href}
              class="flex items-center gap-4 p-5 bg-white rounded-2xl border border-ink-100
                     hover:border-pochi-300 hover:shadow-soft transition-all group"
            >
              <div class="w-12 h-12 rounded-xl bg-pochi-100 text-pochi-600 flex items-center justify-center
                          group-hover:bg-pochi-600 group-hover:text-white transition-colors">
                <Fragment set:html={c.icon} />
              </div>
              <div class="flex-1 min-w-0">
                <div class="text-sm font-semibold text-ink-500">{c.title}</div>
                <div class="font-display font-bold text-ink-900 truncate">{c.value}</div>
              </div>
              <svg class="w-5 h-5 text-ink-400 group-hover:text-pochi-600 group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          ))}
        </div>
      </div>

      <!-- Right: form -->
      <div class="lg:col-span-7 reveal">
        <form class="bg-white rounded-3xl p-7 sm:p-10 shadow-card space-y-5">
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="name" class="block text-sm font-semibold text-ink-900 mb-2">Nombre</label>
              <input
                type="text"
                id="name"
                name="name"
                class="w-full px-4 py-3 rounded-xl border border-ink-200 bg-white
                       focus:outline-none focus:border-pochi-600 focus:ring-4 focus:ring-pochi-100
                       transition-all"
                placeholder="Tu nombre completo"
                required
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-semibold text-ink-900 mb-2">Correo</label>
              <input
                type="email"
                id="email"
                name="email"
                class="w-full px-4 py-3 rounded-xl border border-ink-200 bg-white
                       focus:outline-none focus:border-pochi-600 focus:ring-4 focus:ring-pochi-100
                       transition-all"
                placeholder="tu@correo.com"
                required
              />
            </div>
          </div>

          <div>
            <label for="topic" class="block text-sm font-semibold text-ink-900 mb-2">¿Qué te trae?</label>
            <select
              id="topic"
              name="topic"
              class="w-full px-4 py-3 rounded-xl border border-ink-200 bg-white
                     focus:outline-none focus:border-pochi-600 focus:ring-4 focus:ring-pochi-100
                     transition-all"
            >
              <option>Quiero ser conductor</option>
              <option>Necesito soporte como pasajero</option>
              <option>Pedir cobertura en mi ciudad</option>
              <option>Prensa y medios</option>
              <option>Alianzas comerciales</option>
              <option>Otro</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-sm font-semibold text-ink-900 mb-2">Mensaje</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              class="w-full px-4 py-3 rounded-xl border border-ink-200 bg-white
                     focus:outline-none focus:border-pochi-600 focus:ring-4 focus:ring-pochi-100
                     transition-all resize-none"
              placeholder="Cuéntanos qué necesitas..."
              required
            ></textarea>
          </div>

          <div class="flex items-start gap-3">
            <input
              type="checkbox"
              id="privacy"
              required
              class="mt-1 w-4 h-4 rounded border-ink-300 text-pochi-600 focus:ring-pochi-500"
            />
            <label for="privacy" class="text-sm text-ink-500 leading-relaxed">
              Acepto el <a href="#" class="text-pochi-600 hover:underline font-semibold">aviso de privacidad</a>
              y el tratamiento de mis datos personales.
            </label>
          </div>

          <button type="submit" class="btn-primary w-full !py-4">
            Enviar mensaje
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
