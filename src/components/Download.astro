---
---

<section id="descarga" class="section-y relative overflow-hidden">
  <div class="absolute inset-0 bg-pochi-gradient -z-10"></div>
  <div class="absolute inset-0 grid-pattern opacity-[0.08] -z-10"></div>
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[800px] bg-pochi-300 rounded-full blur-3xl opacity-20 -z-10"></div>

  <div class="container-x">
    <div class="max-w-3xl mx-auto text-center text-white">
      <span class="inline-block px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-sm border border-white/20 text-xs font-semibold tracking-wider uppercase mb-6 reveal">
        ⚡ Disponible muy pronto
      </span>
      <h2 class="heading-xl text-white reveal">
        Descarga PochiGO
      </h2>
      <p class="lead !text-pochi-100 mt-5 reveal">
        Próximamente en App Store y Google Play. Regístrate y te
        avisamos el día que lancemos en tu ciudad.
      </p>

      <!-- Store buttons -->
      <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center reveal">
        <a
          href="#"
          class="group inline-flex items-center gap-3 px-6 py-3.5 rounded-2xl
                 bg-ink-900 hover:bg-black border border-white/10
                 transition-all hover:scale-[1.02]"
        >
          <svg class="w-8 h-8" fill="white" viewBox="0 0 24 24">
            <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
          </svg>
          <div class="text-left">
            <div class="text-xs text-ink-300">Próximamente en</div>
            <div class="font-display font-bold text-white text-base">App Store</div>
          </div>
        </a>

        <a
          href="#"
          class="group inline-flex items-center gap-3 px-6 py-3.5 rounded-2xl
                 bg-ink-900 hover:bg-black border border-white/10
                 transition-all hover:scale-[1.02]"
        >
          <svg class="w-8 h-8" viewBox="0 0 24 24">
            <path fill="#34A853" d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 01-.61-.92V2.734a1 1 0 01.609-.92z"/>
            <path fill="#FBBC04" d="M16.81 15.018L13.792 12 3.61 1.814 16.81 8.982v6.036z"/>
            <path fill="#EA4335" d="M3.609 22.186L13.792 12l3.018 3.018-13.201 7.168z"/>
            <path fill="#4285F4" d="M20.16 10.81L16.81 8.98 13.792 12l3.018 3.018 3.35-1.83a.997.997 0 000-1.378z"/>
          </svg>
          <div class="text-left">
            <div class="text-xs text-ink-300">Próximamente en</div>
            <div class="font-display font-bold text-white text-base">Google Play</div>
          </div>
        </a>
      </div>

      <!-- Email signup -->
      <div class="mt-12 max-w-md mx-auto reveal">
        <div class="text-sm text-pochi-100 mb-3">O déjanos tu correo y te avisamos:</div>
        <form class="flex flex-col sm:flex-row gap-2 p-2 bg-white/10 backdrop-blur-md rounded-2xl border border-white/20">
          <input
            type="email"
            placeholder="tucorreo@ejemplo.com"
            class="flex-1 px-4 py-3 bg-transparent text-white placeholder-pochi-200 focus:outline-none"
            required
          />
          <button
            type="submit"
            class="px-6 py-3 rounded-xl bg-white text-pochi-700 font-bold hover:bg-pochi-50 transition-colors"
          >
            Avísame
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
