---
const cities = [
  { name: 'Playa del Carmen',  state: 'Quintana Roo', status: 'live'    },
  { name: 'Cancún',            state: 'Quintana Roo', status: 'live'    },
  { name: 'Tulum',             state: 'Quintana Roo', status: 'soon'    },
  { name: 'Chetumal',          state: 'Quintana Roo', status: 'soon'    },
  { name: 'Mérida',            state: 'Yucatán',      status: 'soon'    },
  { name: 'Campeche',          state: 'Campeche',     status: 'planned' },
  { name: 'Villahermosa',      state: 'Tabasco',      status: 'planned' },
  { name: 'Veracruz',          state: 'Veracruz',     status: 'planned' },
];

const statusConfig = {
  live:    { label: 'Disponible',  badge: 'bg-success/10 text-success',     dot: 'bg-success' },
  soon:    { label: 'Pronto',      badge: 'bg-warning/10 text-warning',     dot: 'bg-warning' },
  planned: { label: 'Planeado',    badge: 'bg-ink-200 text-ink-600',        dot: 'bg-ink-400' },
};
---

<section id="cobertura" class="section-y bg-white">
  <div class="container-x">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="eyebrow reveal">Dónde estamos</span>
      <h2 class="heading-lg mt-3 reveal">
        Llegamos a tu ciudad
        <span class="gradient-text">poco a poco</span>
      </h2>
      <p class="lead mt-5 reveal">
        Empezamos en el sureste mexicano y vamos creciendo.
        ¿Tu ciudad no está? Avísanos y pídela.
      </p>
    </div>

    <!-- Cities grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {cities.map((city, i) => {
        const cfg = statusConfig[city.status];
        return (
          <div class="card !p-5 reveal" style={`animation-delay: ${i * 60}ms`}>
            <div class="flex items-start justify-between mb-3">
              <div class="w-10 h-10 rounded-xl bg-pochi-50 flex items-center justify-center text-pochi-600">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold ${cfg.badge}`}>
                <span class={`w-1.5 h-1.5 rounded-full ${cfg.dot} ${city.status === 'live' ? 'animate-pulse-slow' : ''}`}></span>
                {cfg.label}
              </span>
            </div>
            <div class="font-display font-bold text-lg text-ink-900">{city.name}</div>
            <div class="text-sm text-ink-500">{city.state}</div>
          </div>
        );
      })}
    </div>

    <!-- Request city CTA -->
    <div class="mt-14 max-w-2xl mx-auto reveal">
      <div class="bg-pochi-gradient-soft rounded-3xl p-8 sm:p-10 text-center border border-pochi-200">
        <div class="text-4xl mb-3">📍</div>
        <h3 class="heading-md text-ink-900 mb-2">¿No vemos tu ciudad?</h3>
        <p class="text-ink-600 mb-6 max-w-md mx-auto">
          Cuéntanos dónde estás y te avisamos cuando lleguemos.
        </p>
        <a href="#contacto" class="btn-primary">
          Pedir mi ciudad
        </a>
      </div>
    </div>
  </div>
</section>
