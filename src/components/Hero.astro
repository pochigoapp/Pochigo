---
---

<section class="relative pt-28 sm:pt-32 lg:pt-36 pb-16 sm:pb-20 lg:pb-28 overflow-hidden">
  <!-- Background decoration -->
  <div class="absolute inset-0 bg-pochi-gradient-soft -z-10"></div>
  <div class="absolute inset-0 grid-pattern opacity-50 -z-10"></div>
  <div class="absolute -top-32 -right-32 w-96 h-96 bg-pochi-300 rounded-full blur-3xl opacity-30 -z-10"></div>
  <div class="absolute -bottom-32 -left-32 w-96 h-96 bg-pochi-400 rounded-full blur-3xl opacity-20 -z-10"></div>

  <div class="container-x">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      <!-- Text -->
      <div class="lg:col-span-7 text-center lg:text-left">
        <span class="eyebrow reveal">🛺 Mototaxi a un toque</span>
        <h1 class="heading-xl text-ink-900 mt-4 reveal">
          Tu mototaxi
          <span class="gradient-text">cuando lo necesites</span>
        </h1>
        <p class="lead mt-6 max-w-xl mx-auto lg:mx-0 reveal">
          Pide, sube y llega. PochiGO conecta pasajeros con conductores
          de mototaxi cerca de ti — rápido, seguro y al mejor precio.
        </p>

        <div class="mt-9 flex flex-col sm:flex-row gap-3 justify-center lg:justify-start reveal">
          <a href="#descarga" class="btn-primary">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
            </svg>
            Descargar la app
          </a>
          <a href="#como-funciona" class="btn-secondary">
            Cómo funciona →
          </a>
        </div>

        <!-- Social proof -->
        <div class="mt-10 flex items-center justify-center lg:justify-start gap-6 reveal">
          <div class="flex items-center gap-2">
            <div class="flex -space-x-2">
              <div class="w-8 h-8 rounded-full bg-pochi-200 border-2 border-white"></div>
              <div class="w-8 h-8 rounded-full bg-pochi-400 border-2 border-white"></div>
              <div class="w-8 h-8 rounded-full bg-pochi-600 border-2 border-white"></div>
            </div>
            <div class="text-sm">
              <div class="font-semibold text-ink-900">+1,000 viajes</div>
              <div class="text-ink-500">cada semana</div>
            </div>
          </div>
          <div class="hidden sm:block w-px h-10 bg-ink-200"></div>
          <div class="hidden sm:flex items-center gap-2">
            <div class="flex">
              {[...Array(5)].map(() => (
                <svg class="w-4 h-4 text-warning" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.957a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.367 2.446a1 1 0 00-.363 1.118l1.286 3.957c.3.921-.755 1.688-1.54 1.118l-3.366-2.446a1 1 0 00-1.176 0l-3.366 2.446c-.784.57-1.838-.197-1.539-1.118l1.286-3.957a1 1 0 00-.363-1.118L2.06 9.384c-.783-.57-.38-1.81.588-1.81h4.162a1 1 0 00.95-.69L9.05 2.927z"/>
                </svg>
              ))}
            </div>
            <div class="text-sm">
              <div class="font-semibold text-ink-900">4.9 / 5</div>
              <div class="text-ink-500">calificación</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Phone mockup -->
      <div class="lg:col-span-5 reveal">
        <div class="relative max-w-sm mx-auto">
          <!-- Glow behind phone -->
          <div class="absolute inset-0 bg-pochi-gradient blur-3xl opacity-30 rounded-full"></div>

          <!-- Phone frame -->
          <div class="relative animate-float">
            <div class="bg-ink-900 rounded-[3rem] p-3 shadow-glow">
              <div class="bg-white rounded-[2.4rem] overflow-hidden aspect-[9/19]">
                <!-- App mockup -->
                <div class="h-full flex flex-col bg-pochi-50">
                  <!-- Status bar -->
                  <div class="flex justify-between items-center px-6 pt-3 pb-2 text-xs font-semibold text-ink-900">
                    <span>9:41</span>
                    <span>•••</span>
                  </div>
                  <!-- Map area -->
                  <div class="flex-1 bg-gradient-to-br from-pochi-100 to-pochi-200 relative overflow-hidden">
                    <!-- Route line -->
                    <svg class="absolute inset-0 w-full h-full" preserveAspectRatio="none" viewBox="0 0 200 400">
                      <path
                        d="M 40 80 Q 100 150, 80 220 T 160 340"
                        stroke="#7C3AED"
                        stroke-width="4"
                        fill="none"
                        stroke-linecap="round"
                        stroke-dasharray="0,0"
                      />
                    </svg>
                    <!-- Pickup pin -->
                    <div class="absolute" style="top: 18%; left: 18%;">
                      <div class="w-4 h-4 rounded-full bg-success border-[3px] border-white shadow-lg"></div>
                    </div>
                    <!-- Destination pin -->
                    <div class="absolute" style="top: 80%; left: 75%;">
                      <div class="w-5 h-5 rounded-full bg-pochi-600 border-[3px] border-white shadow-lg"></div>
                    </div>
                    <!-- Moto icon -->
                    <div class="absolute" style="top: 50%; left: 38%;">
                      <div class="w-9 h-9 bg-white rounded-full shadow-lg flex items-center justify-center text-lg">
                        🛺
                      </div>
                    </div>
                  </div>
                  <!-- Bottom card -->
                  <div class="bg-white rounded-t-3xl px-5 pt-5 pb-6 -mt-5 relative shadow-xl">
                    <div class="w-10 h-1 bg-ink-200 rounded-full mx-auto mb-4"></div>
                    <div class="flex items-center gap-3 mb-3">
                      <div class="w-12 h-12 rounded-full bg-pochi-100 flex items-center justify-center text-2xl">
                        🛺
                      </div>
                      <div class="flex-1">
                        <div class="font-bold text-ink-900 text-sm">Carlos M.</div>
                        <div class="text-xs text-ink-500">Italika DT 150 · QHR-432</div>
                      </div>
                      <div class="text-right">
                        <div class="text-xs text-ink-500">Llegada</div>
                        <div class="font-bold text-pochi-600">3 min</div>
                      </div>
                    </div>
                    <div class="bg-pochi-600 text-white text-center py-3 rounded-xl font-bold text-sm">
                      $46 MXN
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
