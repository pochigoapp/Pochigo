---
const navLinks = [
  { label: 'Cómo funciona', href: '#como-funciona' },
  { label: 'Beneficios',    href: '#pasajeros' },
  { label: 'Cobertura',     href: '#cobertura' },
  { label: 'Contacto',      href: '#contacto' },
];
---

<header
  id="site-header"
  class="fixed top-0 inset-x-0 z-50 transition-all duration-300
         bg-white/80 backdrop-blur-lg border-b border-ink-100"
>
  <div class="container-x flex items-center justify-between h-16 sm:h-20">
    <!-- Logo -->
    <a href="#" class="flex items-center gap-2.5 group">
      <img
        src={`${import.meta.env.BASE_URL}images/logo-icon.png`}
        alt="PochiGO"
        class="h-9 w-9 sm:h-10 sm:w-10 rounded-xl transition-transform group-hover:scale-105"
        width="40"
        height="40"
      />
      <span class="font-display font-extrabold text-xl sm:text-2xl text-ink-900 tracking-tight">
        Pochi<span class="text-pochi-600">GO</span>
      </span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden lg:flex items-center gap-8">
      {navLinks.map(({ label, href }) => (
        <a
          href={href}
          class="text-sm font-semibold text-ink-700 hover:text-pochi-600 transition-colors"
        >
          {label}
        </a>
      ))}
    </nav>

    <!-- CTA + mobile toggle -->
    <div class="flex items-center gap-3">
      <a href="#descarga" class="hidden sm:inline-flex btn-primary text-sm py-2.5 px-5">
        Descargar
      </a>
      <button
        id="menu-toggle"
        class="lg:hidden p-2 rounded-lg hover:bg-ink-100 transition-colors"
        aria-label="Abrir menú"
      >
        <svg class="w-6 h-6 text-ink-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="lg:hidden hidden border-t border-ink-100 bg-white">
    <nav class="container-x py-4 flex flex-col gap-1">
      {navLinks.map(({ label, href }) => (
        <a
          href={href}
          class="py-3 px-3 rounded-lg text-base font-semibold text-ink-700 hover:bg-pochi-50 hover:text-pochi-600 transition-colors"
        >
          {label}
        </a>
      ))}
      <a href="#descarga" class="btn-primary mt-3">Descargar app</a>
    </nav>
  </div>
</header>

<script>
  // Mobile menu toggle
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
  // Close menu on link click
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => menu.classList.add('hidden'))
  );

  // Header shadow on scroll
  const header = document.getElementById('site-header');
  const onScroll = () => {
    if (!header) return;
    if (window.scrollY > 8) {
      header.classList.add('shadow-soft');
    } else {
      header.classList.remove('shadow-soft');
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
